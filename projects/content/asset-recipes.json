{
  "README.md": { "op": "copy" },
  "audio": { "op": "copy" },
  "audio/death/generals": { "op": "copy", "ext": "ogg" },
  "effects/frames": { "op": "master-only" },
  "effects/sheets": {
    "op": "sheets",
    "from": "effects/frames",
    "ext": "webp",
    "quality": 85,
    "map": {
      "slash": "slash-red",
      "slash-fire": "fire-slash",
      "slash-lightning": "thunder-slash",
      "damage": "damage",
      "fire": "fire",
      "lightning": "lightning",
      "chain": "chain"
    }
  },
  "effects/stills": { "op": "copy" },
  "generals/cards": { "op": "image", "ext": "webp", "quality": 85, "maxWidth": 320 },
  "generals/skins": { "op": "image", "ext": "webp", "quality": 85 },
  "generals/skins/skins.json": { "op": "copy" },
  "generals/special": { "op": "copy" },
  "manifest.json": { "op": "copy" },
  "playing-cards": { "op": "copy" },
  "playing-cards/cropped": { "op": "crop", "from": "playing-cards/full", "ext": "webp", "quality": 85, "maxWidth": 320 },
  "playing-cards/full": { "op": "image", "ext": "webp", "quality": 85, "maxWidth": 320 },
  "preview": { "op": "copy" },
  "ui": { "op": "copy" }
}
