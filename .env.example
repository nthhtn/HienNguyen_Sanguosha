# Copy to .env for `npm run server`. Without DATABASE_URL the server uses an
# in-memory store (fine for UI work; nothing survives a restart).
DATABASE_URL=postgres://sanguosha:sanguosha@localhost:5433/sanguosha
PUBLIC_ORIGIN=http://localhost:4200
PORT=4201
# Behind a reverse proxy: a hop count (e.g. 1) or the proxies' addresses/CIDRs.
# TRUST_PROXY=1

# Production (set in Render, see docs/deployment.md):
# NODE_ENV=production
# PUBLIC_ORIGIN=https://<name>.onrender.com
# DATABASE_URL=<Supabase session pooler string>
# DATABASE_SSL=require
# TRUST_PROXY=1
# STATIC_DIR=<built app directory; the Docker image sets it>
