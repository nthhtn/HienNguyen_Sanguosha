# Copy to .env for `npm run server`. Without DATABASE_URL the server uses an
# in-memory store (fine for UI work; nothing survives a restart).
DATABASE_URL=postgres://sanguosha:sanguosha@localhost:5433/sanguosha
PUBLIC_ORIGIN=http://localhost:4200
PORT=4201
# Phone / PWA testing through a Cloudflare quick tunnel:
# - Run `npm start` (not `npm run web` alone — the API must be up).
# - Point cloudflared at http://127.0.0.1:<ng-port> (same port as `ng serve`).
# - Open or install the PWA at https://<name>.trycloudflare.com (quick tunnels change when cloudflared restarts — reinstall the PWA if the host changes).
# - Leave PUBLIC_ORIGIN on localhost; development accepts tunnel Origins and marks session cookies Secure when the browser uses https.
# Continue with Google (optional; both or neither). Redirect URI to register in Google Cloud:
#   http://localhost:4200/api/auth/google/callback  (see docs/deployment.md, "Google sign-in")
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Behind a reverse proxy: a hop count (e.g. 1) or the proxies' addresses/CIDRs.
# TRUST_PROXY=1

# Production (set in Render, see docs/deployment.md):
# NODE_ENV=production
# PUBLIC_ORIGIN=https://<name>.onrender.com
# DATABASE_URL=<Supabase session pooler string>
# DATABASE_SSL=require   (required in production; off for a local Postgres)
# TRUST_PROXY=1
# STATIC_DIR=<built app directory; the Docker image sets it>
