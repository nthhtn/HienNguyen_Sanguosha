{
  "name": "my-sanguosha-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "server": "tsx watch --tsconfig projects/server/tsconfig.json projects/server/src/main.ts",
    "sim": "tsx --tsconfig projects/sim/tsconfig.json projects/sim/src/cli.ts",
    "start": "node --watch-path=angular.json --watch-path=tsconfig.json --watch-path=projects/app/tsconfig.app.json --watch-path=package.json --watch-preserve-output scripts/dev-server.mjs",
    "web": "node --watch-path=angular.json --watch-path=tsconfig.json --watch-path=projects/app/tsconfig.app.json --watch-path=package.json --watch-preserve-output scripts/dev-server.mjs --web-only",
    "build": "npm run build:engine && npm run build:content && npm run build:app",
    "build:engine": "ng build engine",
    "build:content": "ng build content",
    "build:app": "ng build app",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "coverage:check": "node scripts/check-coverage.mjs",
    "lint": "eslint .",
    "test:guardrails": "node --test \".claude/**/*.test.mjs\"",
    "i18n:status": "tsx --tsconfig tsconfig.json scripts/i18n-status.ts",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "test:db": "TEST_DATABASE_URL=postgres://sanguosha:sanguosha@localhost:5433/postgres jest --selectProjects server",
    "typecheck": "tsc -p projects/protocol/tsconfig.json --noEmit && tsc -p projects/server/tsconfig.json --noEmit && tsc -p projects/bots/tsconfig.json --noEmit && tsc -p projects/sim/tsconfig.json --noEmit && tsc -p projects/app/tsconfig.app.json --noEmit && tsc -p projects/app/tsconfig.spec.json --noEmit && tsc -p projects/engine/tsconfig.spec.json --noEmit && tsc -p projects/content/tsconfig.spec.json --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run build",
    "typecheck:server": "tsc -p projects/protocol/tsconfig.json --noEmit && tsc -p projects/server/tsconfig.json --noEmit"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.2.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@fastify/cookie": "11.0.2",
    "@fastify/type-provider-typebox": "^5.2.0",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.12.6",
    "kysely": "~0.28.17",
    "pg": "^8.23.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "angular-eslint": "^22.6.0",
    "eslint": "^9.39.5",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jest-preset-angular": "^17.0.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "light-my-request": "6.6.0"
  }
}
