{
  "permissions": {
    "deny": [
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
      "Bash(gh api *merge*)",
      "Bash(git push * main)",
      "Bash(git push main)",
      "Bash(git push *:main)",
      "Bash(git push *:refs/heads/main)",
      "Bash(git push * +main)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pr-gate.mjs",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
