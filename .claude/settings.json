{
  "permissions": {
    "deny": [
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
      "Bash(gh pr * merge)",
      "Bash(gh pr * merge *)",
      "Bash(gh api *merge*)",
      "Bash(gh api *Merge*)",
      "Bash(gh api *refs/heads/main*)",
      "Bash(gh api *git/refs*)",
      "Bash(gh api *contents*)",
      "Bash(gh api *graphql*)",
      "Bash(git push)",
      "Bash(git push origin)",
      "Bash(git push origin HEAD)",
      "Bash(git push *--all*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--tags*)",
      "Bash(git push main)",
      "Bash(git push main *)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *:refs/heads/main)",
      "Bash(git push *:refs/heads/main *)",
      "Bash(git push *:heads/main*)",
      "Bash(git push * refs/heads/main*)",
      "Bash(git push refs/heads/main*)",
      "Bash(git push +*)",
      "Bash(git push * +*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git * push)",
      "Bash(git * push origin)",
      "Bash(git * push origin HEAD)",
      "Bash(git * push *--all*)",
      "Bash(git * push *--mirror*)",
      "Bash(git * push *--tags*)",
      "Bash(git * push main)",
      "Bash(git * push main *)",
      "Bash(git * push * main)",
      "Bash(git * push * main *)",
      "Bash(git * push *:main)",
      "Bash(git * push *:main *)",
      "Bash(git * push *:refs/heads/main)",
      "Bash(git * push *:refs/heads/main *)",
      "Bash(git * push *:heads/main*)",
      "Bash(git * push * refs/heads/main*)",
      "Bash(git * push refs/heads/main*)",
      "Bash(git * push +*)",
      "Bash(git * push * +*)",
      "Bash(git * push -f*)",
      "Bash(git * push * -f*)",
      "Bash(git * push --force*)",
      "Bash(git * push * --force*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pr-gate.mjs\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
