{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "f7ff1abe-212b-4f35-a32c-396cf9b0b84c"
  },
  "newProjectRoot": "projects",
  "projects": {
    "engine": {
      "projectType": "library",
      "root": "projects/engine",
      "sourceRoot": "projects/engine/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/engine/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/engine/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    },
    "content": {
      "projectType": "library",
      "root": "projects/content",
      "sourceRoot": "projects/content/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/content/tsconfig.ngbuild.prod.json"
            },
            "development": {
              "tsConfig": "projects/content/tsconfig.ngbuild.json"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  }
}
